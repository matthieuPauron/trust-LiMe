# PARALLEL OK #

# ============================================================================= #
# Case F : spatially varying velocity, uniform field stays uniform #
# ============================================================================= #
# Exercises the vitesse_magnetique reading path with a functional velocity  #
# (Champ_Fonc_xyz). With uniform b = b0, (u.grad) b = 0 and diffusion 0,   #
# so b must remain b0 exactly, whatever u. Velocity: vortex u = (-y, x).   #
# ============================================================================= #
dimension 2
Pb_MHD pb
Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave pavé
    {
        Origine              0.  0.
        Nombre_de_Noeuds     $nx $ny
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.
    }
}
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 1.
    dt_max 0.02
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    nb_composantes 1
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 1.0
        # strongly varying vortex velocity u = (-y, x) #
        vitesse_magnetique     Champ_Fonc_xyz dom 2 -y x

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche  Neumann_Paroi_adiabatique
            droite  Neumann_Paroi_adiabatique
            bas     Neumann_Paroi_adiabatique
            haut    Neumann_Paroi_adiabatique
        }
        initial_conditions { magnetic_field Champ_Uniforme 1 3.0 }
  }

  Postraitement
  {
    Sondes
    {
      sonde_cbx grav magnetic_field Periode 1e-6 Points 1 0.5 0.5
    }
  }
  
}

Solve pb
