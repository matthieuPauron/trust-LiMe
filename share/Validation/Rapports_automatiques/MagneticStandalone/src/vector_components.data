dimension 2
Pb_MHD pb
Domaine dom

Mailler dom
{
    Pave pavé
    {
        Origine              0.  0.
        Nombre_de_Noeuds     49  49
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.
    }
}

Polymac_p0 dis

Associate pb dom


Schema_euler_implicite sch
Read sch
{
    tinit 0.
    tmax 0.5
    dt_max 0.005
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis
Read pb
{
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 0.02

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche  Temperature_imposee_paroi Champ_front_uniforme 1 0.
            droite  Temperature_imposee_paroi Champ_front_uniforme 1 0.
            bas     Temperature_imposee_paroi Champ_front_uniforme 1 0.
            haut    Temperature_imposee_paroi Champ_front_uniforme 1 0.
        }
        initial_conditions
        {
            magnetic_field Champ_Fonc_xyz dom 1 sin(pi*x)*sin(pi*y)
        }
  }

Postraitement
{
    Sondes
    {
        sonde_bx grav magnetic_field Periode 1e-6 Points 1 0.25 0.5
        sonde_by grav magnetic_field Periode 1e-6 Points 1 0.25 0.5
    }
}

}

Solve pb
