
dimension 2
Pb_MHD pb
Domaine dom

Mailler dom
{
    Pave pavé
    {
        Origine              0.  0.
        Nombre_de_Noeuds     17  17
        Longueurs            1.  1.
    }
    {
        gauche   X = 0.    0. <= Y <= 1.
        droite   X = 1.    0. <= Y <= 1.
        bas      Y = 0.    0. <= X <= 1.
        haut     Y = 1.    0. <= X <= 1.
    }
}

Decouper dom
{
    Partitionneur tranche { tranches 2 2 }
    Larg_joint 2
    Nom_Zones dom
}
Fin

Scatter dom.Zones dom

Polymac_p0 dis

Associate pb dom
Discretize pb dis

Schema_euler_implicite sch
Read sch
{
    tinit 0.
    tmax 1.
    dt_max 0.05
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch

Read pb
{
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 1.0

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche  Neumann_Paroi_adiabatique
            droite  Neumann_Paroi_adiabatique
            bas     Neumann_Paroi_adiabatique
            haut    Neumann_Paroi_adiabatique
        }
        initial_conditions { magnetic_field Champ_Uniforme 1 3.0 }
    }
}

Postraitement
{
    Sondes
    {
        sonde_cbx grav magnetic_field Periode 1e-6 Points 1 0.5 0.5
    }
}

Solve pb
