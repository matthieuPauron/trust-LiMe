# ============================================================================= #
# Case D : multi-component (vector) magnetic field                              #
# ============================================================================= #
# Exercises the default component count (nb_composantes omitted -> dimension)   #
# and component independence. In 2D with homogeneous Dirichlet on all faces:    #
#     bx = sin(pi x)  sin(pi y) exp(-2 eta pi^2 t)                              #
#     by = sin(2pi x) sin(pi y) exp(-5 eta pi^2 t)                              #
# CAVEAT: initial condition is not div-free; this validates the multi-          #
# component transport machinery only (the induction operator requires           #
# div b = 0 to reduce to convection-diffusion).                                 #
# ============================================================================= #

dimension 2
Pb_MHD pb
Domaine dom

Mailler dom
{
    Pave pavé
    {
        Origine              0.  0.
        Nombre_de_Noeuds     49  49
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.
    }
}

Polymac_p0 dis

Associate pb dom

Schema_euler_implicite sch
Read sch
{
    tinit 0.
    tmax 0.5
    dt_max 0.005
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis
Read pb
{
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    # nb_composantes omitted on purpose: defaults to the space dimension (2) #
    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 0.02

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            # homogeneous Dirichlet on all faces (valid for both eigenmodes) #
            gauche  Temperature_imposee_paroi Champ_front_uniforme 2 0. 0.
            droite  Temperature_imposee_paroi Champ_front_uniforme 2 0. 0.
            bas     Temperature_imposee_paroi Champ_front_uniforme 2 0. 0.
            haut    Temperature_imposee_paroi Champ_front_uniforme 2 0. 0.
        }
        initial_conditions
        {
            magnetic_field Champ_Fonc_xyz dom 2 sin(pi*x)*sin(pi*y) sin(2*pi*x)*sin(pi*y)
        }
  }

Postraitement
{
    Sondes
    {
        # component probes: magnetic_field0 = bx, magnetic_field1 = by #
        SONDE_BX grav magnetic_field0 Periode 1e-6 Points 1 0.25 0.5
        SONDE_BY grav magnetic_field1 Periode 1e-6 Points 1 0.25 0.5
    }
}

}

Solve pb
