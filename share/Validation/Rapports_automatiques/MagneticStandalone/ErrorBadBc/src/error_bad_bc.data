# ============================================================================= #
# Case A : invariance of a uniform magnetic field  (TRUST-LiMe standalone MHD) #
# ============================================================================= #
#  Solves   d b / dt + (u.grad) b - div(eta grad b) = 0 #
#  with a spatially uniform b and a zero velocity.  Both (u.grad)b and #
#  div(eta grad b) vanish identically, therefore b must stay exactly equal to #
#  its initial value for all time. #
# #
#  This is a pure *invariant* test: it is independent of the discretisation and #
#  must hold to machine precision.  It catches spurious sources/sinks, a wrong #
#  mass-matrix coefficient, a mis-wired diffusivity, a bad velocity default and #
#  boundary-condition assembly errors. #
# ============================================================================= #

dimension 2
Pb_MHD pb
Domaine dom

# --------------------------------- mesh ------------------------------------ #
Mailler dom
{
    Pave pavé
    {
        Origine              0.  0.
        Nombre_de_Noeuds     100  100
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.
    }
}

# ------------------------------- discretisation ------------------------------ #
Polymac_p0 dis

Associate pb dom

# ------------------------------ time integration ---------------------------- #
Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 1.
    dt_max 0.05
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

# ---------------------------------- physics --------------------------------- #
Read pb
{
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        nb_composantes         1
        diffusivite_magnetique Champ_Uniforme 1 1.0
        # `vitesse_magnetique` omitted on purpose -> u = 0; and since b is uniform, #
        # grad b = 0 too, so both transport terms vanish identically. #

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            Bord gauche  condition_qui_nexiste_pas # DELIBERATELY INVALID keyword -> must fail cleanly #
            Bord droite  Neumann_Paroi_adiabatique
            Bord bas     Neumann_Paroi_adiabatique
            Bord haut    Neumann_Paroi_adiabatique
        }
        initial_conditions { magnetic_field Champ_Uniforme 1 3.0 }
    }
}

# --------------------------------- postprocessing --------------------------- #
Postraitement
{
    Sondes
    {
        sonde_cbx grav magnetic_field Periode dts Points 1 0.5 0.5
    }
}

Solve pb
