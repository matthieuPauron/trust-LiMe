# ============================================================================= #
# Turbulent magnetic diffusion: decay of a Fourier mode with eta + eta_t       #
# (VEF, triangular mesh, nb_composantes 1, K_Epsilon hydraulic turbulence).    #
# ============================================================================= #
dimension 2
Pb_MHD_Turbulent pb
Domaine dom

Mailler dom
{
    Pave pave
    {
        Origine              0.  0.
        Nombre_de_Noeuds     $nx $ny
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.
    }
}
Trianguler dom
VerifierCoin dom { }

VEFPreP1B dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 1.
    dt_max 0.01
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    nb_composantes 1
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Navier_Stokes_turbulent
    {
        solveur_pression Petsc Cholesky { }
        convection { negligeable }
        diffusion { negligeable }
        initial_conditions { vitesse Champ_Uniforme 2 0. 0. }
        boundary_conditions
        {
            gauche  symetrie
            droite  symetrie
            bas     symetrie
            haut    symetrie
        }
        modele_turbulence K_Epsilon
        {
            turbulence_paroi negligeable
            Transport_equation transport_k_epsilon
            {
                convection { negligeable }
                diffusion { negligeable }
                boundary_conditions
                {
                    gauche symetrie
                    droite symetrie
                    haut   symetrie
                    bas    symetrie
                }
                initial_conditions
                {
                    k_Eps Champ_fonc_txyz dom 2 0.5 0.5
                }
            }
        }
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 0.05
        vitesse_hydraulique
        C_mu_magnetique 0.09
        prandtl_turbulent_magnetique 1.0

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche  Neumann_Paroi_adiabatique
            droite  Neumann_Paroi_adiabatique
            bas     Temperature_imposee_paroi Champ_front_uniforme 1 0.
            haut    Temperature_imposee_paroi Champ_front_uniforme 1 0.
        }
        initial_conditions { magnetic_field Champ_Fonc_xyz dom 1 sin(pi*y) }
  }

  Postraitement
  {
    Sondes
    {
      sonde_y050 grav magnetic_field Periode 1e-6 Points 1 0.5 0.50
    }
  }
}

Solve pb
