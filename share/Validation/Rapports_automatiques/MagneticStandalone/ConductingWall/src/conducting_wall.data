# PARALLEL OK #

dimension 2
Pb_Induction pb
Domaine dom

Mailler dom
{
    Pave pave
    {
        Origine              0.  0.
        Nombre_de_Noeuds     9 9
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.
    }
}

Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 0.1
    dt_max 0.01
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    nb_composantes 1
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 0.05
        diffusion  { }
        convection { amont }
        boundary_conditions
        {
            gauche  paroi_conductrice_magnetique
            droite  paroi_conductrice_magnetique
            bas     paroi_conductrice_magnetique
            haut    paroi_conductrice_magnetique
        }
        initial_conditions { magnetic_field Champ_Fonc_xyz dom 1 sin(pi*y)*sin(pi*x) }
    }
}

Solve pb
