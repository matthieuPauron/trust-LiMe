# PARALLEL OK #

# ============================================================================= #
# Case : Shercliff2D channel induced field and current density #
# ============================================================================= #
# TRUST-LiMe standalone MHD. #
# One-dimensional physics, plates at y = plus/minus 0.5, insulating walls. #
# ============================================================================= #
dimension 2
Pb_MHD pb
Domaine dom

# plates at y = +/- 0.5 : walls are the two bords normal to Y #

# BEGIN MESH #
Mailler dom
{
    Pave pave
    {
        Origine              0. -0.5
        Nombre_de_Noeuds     $nx $ny
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.   -0.5 <= Y <= 0.5
        Bord droite   X = 1.   -0.5 <= Y <= 0.5
        Bord bas      Y = -0.5  0. <= X <= 1.
        Bord haut     Y = 0.5   0. <= X <= 1.
    }
}
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 25.
    dt_max 0.05
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    # vector model: b = (b_x induced, B0 applied) #
    nb_composantes 2
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 0.05
        # parabolic no-slip velocity u = (U0(1-y^2/h^2), 0) #
        vitesse_magnetique     Champ_Fonc_xyz dom 2 1.0*(1-y*y/0.25) 0.

        diffusion  { }
        convection { amont }

        # M1 inductive stretching source S = (b.grad) u : S_x = B0 u'(y) #
        sources
        {
            induction_stretching { }
        }

        boundary_conditions
        {
            # insulating walls: zero normal flux on both components #
            gauche  paroi_isolante_magnetique
            droite  paroi_isolante_magnetique
            bas     paroi_isolante_magnetique
            haut    paroi_isolante_magnetique
        }
        # b = (0, B0) initially : the induced field grows from zero #
        initial_conditions { magnetic_field Champ_Uniforme 2 0. 1. }
    }

  Postraitement
  {
    Sondes
    {
      sonde_c1  grav magnetic_field0 Periode 1e-6 Points 1 0.125 -0.0546875
      sonde_c2  grav magnetic_field0 Periode 1e-6 Points 1 0.125 -0.0234375
      sonde_c3  grav magnetic_field0 Periode 1e-6 Points 1 0.125  0.0078125
      sonde_c4  grav magnetic_field0 Periode 1e-6 Points 1 0.125  0.0390625
      sonde_c5  grav magnetic_field0 Periode 1e-6 Points 1 0.125  0.0703125
      sonde_w1  grav magnetic_field0 Periode 1e-6 Points 1 0.125 -0.3828125
      sonde_w2  grav magnetic_field0 Periode 1e-6 Points 1 0.125  0.3828125
      sonde_by  grav magnetic_field1 Periode 1e-6 Points 1 0.125  0.0078125
      sonde_j   grav courant_magnetique Periode 1e-6 Points 1 0.125  0.0078125
    }
  }

}

Solve pb
