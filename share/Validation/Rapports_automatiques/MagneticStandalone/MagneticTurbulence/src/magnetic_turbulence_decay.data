# Magnetic k-epsilon source-only analytic decay verification.                 #
# Uniform b_A gives zero curl/production; uniform k_b and epsilon_b have no     #
# convective or diffusive transport.                                          #
Dimension 2
Pb_Induction pb

Domaine dom
Mailler dom
{
    Pave pave
    {
        Origine 0. 0.
        Nombre_de_Noeuds $nx $ny
        Longueurs 1. 1.
    }
    {
        Bord gauche X = 0. 0. <= Y <= 1.
        Bord droite X = 1. 0. <= Y <= 1.
        Bord bas Y = 0. 0. <= X <= 1.
        Bord haut Y = 1. 0. <= X <= 1.
    }
}

Polymac_p0 dis
Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax $tmax
    dt_min $dt
    dt_max $dt
    dt_impr $dt
    facsec 1e6
    facsec_max 1e6
    nb_pas_dt_max 200
    solveur implicite { solveur petsc cli { } }
}

Associate pb dom
Associate pb sch
Discretize pb dis

Read pb
{
    nb_composantes 1
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.
        rho     Champ_Uniforme 1 1.
        lambda  Champ_Uniforme 1 1.
        Cp      Champ_Uniforme 1 1.
        beta_th Champ_Uniforme 1 0.
    }
    Convection_Diffusion_Magnetic_field
    {
        equation_non_resolue (t>0)
        diffusivite_magnetique Champ_Uniforme 1 1e-4
        vitesse_magnetique Champ_Uniforme 2 0. 0.
        modele_turbulence_magnetique
        {
            C_mu_b 0.09
            C_eps1b 1.44
            C_eps2b 1.92
            sigma_kb 1.
            sigma_epsilonb 1.3
            prandtl_turbulent_magnetique_b 1.
            k_b_min 1e-20
            epsilon_b_min 1e-12
        }
        diffusion { }
        convection { amont }
        boundary_conditions
        {
            gauche Neumann_Paroi_adiabatique
            droite Neumann_Paroi_adiabatique
            bas Neumann_Paroi_adiabatique
            haut Neumann_Paroi_adiabatique
        }
        initial_conditions { magnetic_field Champ_Uniforme 1 1. }
    }
    Convection_Diffusion_K_Magnetic
    {
        diffusion { }
        convection { amont }
        boundary_conditions
        {
            gauche Neumann_Paroi_adiabatique
            droite Neumann_Paroi_adiabatique
            bas Neumann_Paroi_adiabatique
            haut Neumann_Paroi_adiabatique
        }
        initial_conditions { k_b Champ_Uniforme 1 1e-6 }
    }
    Convection_Diffusion_Epsilon_Magnetic
    {
        diffusion { }
        convection { amont }
        boundary_conditions
        {
            gauche Neumann_Paroi_adiabatique
            droite Neumann_Paroi_adiabatique
            bas Neumann_Paroi_adiabatique
            haut Neumann_Paroi_adiabatique
        }
        initial_conditions { epsilon_b Champ_Uniforme 1 1e-7 }
    }

    Post_processing
    {
        Definition_champs
        {
            conv_k Interpolation
            {
                localisation elem
                source operateur_eqn
                {
                    numero_op 1
                    sources { refChamp { pb_champ pb k_b } }
                }
            }
            diff_k Interpolation
            {
                localisation elem
                source operateur_eqn
                {
                    numero_op 0
                    sources { refChamp { pb_champ pb k_b } }
                }
            }
            conv_epsilon Interpolation
            {
                localisation elem
                source operateur_eqn
                {
                    numero_op 1
                    sources { refChamp { pb_champ pb epsilon_b } }
                }
            }
            diff_epsilon Interpolation
            {
                localisation elem
                source operateur_eqn
                {
                    numero_op 0
                    sources { refChamp { pb_champ pb epsilon_b } }
                }
            }
        }
        Sondes
        {
            SONDE_K grav k_b periode $dt Points 1 0.5 0.5
            SONDE_EPSILON grav epsilon_b periode $dt Points 1 0.5 0.5
            SONDE_CONV_K grav conv_k periode $dt Points 1 0.5 0.5
            SONDE_DIFF_K grav diff_k periode $dt Points 1 0.5 0.5
            SONDE_CONV_EPSILON grav conv_epsilon periode $dt Points 1 0.5 0.5
            SONDE_DIFF_EPSILON grav diff_epsilon periode $dt Points 1 0.5 0.5
        }
    }
}
Solve pb
