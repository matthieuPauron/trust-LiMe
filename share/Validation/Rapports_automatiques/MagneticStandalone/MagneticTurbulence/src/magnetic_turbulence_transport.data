# Magnetic k-epsilon solved spatial-transport verification (PolyMAC_P0).     #
# Nonuniform k_b and epsilon_b evolve under the model velocity field; b is   #
# uniform so production P_b vanishes and transport dominates.                 #
Dimension 2
Pb_Induction pb

Domaine dom
Mailler dom
{
    Pave pave
    {
        Origine 0. 0.
        Nombre_de_Noeuds $nx $ny
        Longueurs 1. 1.
    }
    {
        Bord gauche X = 0. 0. <= Y <= 1.
        Bord droite X = 1. 0. <= Y <= 1.
        Bord bas Y = 0. 0. <= X <= 1.
        Bord haut Y = 1. 0. <= X <= 1.
    }
}

Polymac_p0 dis
Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax $tmax
    dt_min $dt
    dt_max $dt
    dt_impr $dt
    facsec 1e6
    facsec_max 1e6
    nb_pas_dt_max 200
    solveur implicite { solveur petsc cli { } }
}

Associate pb dom
Associate pb sch
Discretize pb dis

Read pb
{
    nb_composantes 1
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.
        rho     Champ_Uniforme 1 1.
        lambda  Champ_Uniforme 1 1.
        Cp      Champ_Uniforme 1 1.
        beta_th Champ_Uniforme 1 0.
    }
    Convection_Diffusion_Magnetic_field
    {
        equation_non_resolue (t>0)
        diffusivite_magnetique Champ_Uniforme 1 1e-4
        vitesse_magnetique Champ_Fonc_xyz dom 2 sin(2*pi*x)*cos(2*pi*y) -cos(2*pi*x)*sin(2*pi*y)
        modele_turbulence_magnetique
        {
            C_mu_b 0.09
            C_eps1b 1.44
            C_eps2b 1.92
            sigma_kb 1.
            sigma_epsilonb 1.3
            prandtl_turbulent_magnetique_b 1.
            k_b_min 1e-20
            epsilon_b_min 1e-12
        }
        diffusion { }
        convection { amont }
        boundary_conditions
        {
            gauche Neumann_Paroi_adiabatique
            droite Neumann_Paroi_adiabatique
            bas Neumann_Paroi_adiabatique
            haut Neumann_Paroi_adiabatique
        }
        initial_conditions { magnetic_field Champ_Uniforme 1 1. }
    }
    Convection_Diffusion_K_Magnetic
    {
        diffusion { }
        convection { amont }
        boundary_conditions
        {
            gauche Neumann_Paroi_adiabatique
            droite Neumann_Paroi_adiabatique
            bas Neumann_Paroi_adiabatique
            haut Neumann_Paroi_adiabatique
        }
        initial_conditions
        {
            k_b Champ_Fonc_xyz dom 1 2.+0.25*cos(2*pi*x)+0.15*cos(2*pi*y)
        }
    }
    Convection_Diffusion_Epsilon_Magnetic
    {
        diffusion { }
        convection { amont }
        boundary_conditions
        {
            gauche Neumann_Paroi_adiabatique
            droite Neumann_Paroi_adiabatique
            bas Neumann_Paroi_adiabatique
            haut Neumann_Paroi_adiabatique
        }
        initial_conditions
        {
            epsilon_b Champ_Fonc_xyz dom 1 3.+0.2*cos(2*pi*x)+0.1*cos(2*pi*y)
        }
    }

    Post_processing
    {
        Sondes
        {
            SONDE_K grav k_b periode $dt Points 1 0.5 0.5
            SONDE_EPSILON grav epsilon_b periode $dt Points 1 0.5 0.5
        }
    }
}
Solve pb
