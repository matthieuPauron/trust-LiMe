# ============================================================================= #
# Magnetic turbulence: independent k_b/epsilon_b closure (Phase 3).             #
# ============================================================================= #
dimension 2
Pb_Induction pb
Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave pave
    {
        Origine 0. 0.
        Nombre_de_Noeuds $nx $ny
        Longueurs 1. 1.
    }
    {
        Bord gauche X = 0. 0. <= Y <= 1.
        Bord droite X = 1. 0. <= Y <= 1.
        Bord bas Y = 0. 0. <= X <= 1.
        Bord haut Y = 1. 0. <= X <= 1.
    }
}
# END MESH #

Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 0.001
    dt_max 0.0001
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    nb_composantes 1
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.
        rho     Champ_Uniforme 1 1.
        lambda  Champ_Uniforme 1 1.
        Cp      Champ_Uniforme 1 1.
        beta_th Champ_Uniforme 1 0.
    }
    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 0.01
        modele_turbulence_magnetique
        {
            C_mu_b 0.09
            C_eps1b 1.44
            C_eps2b 1.92
            sigma_kb 1.
            sigma_epsilonb 1.3
            prandtl_turbulent_magnetique_b 1.
            k_b_min 1e-20
            epsilon_b_min 1e-12
        }
        diffusion { }
        convection { amont }
        boundary_conditions
        {
            gauche Neumann_Paroi_adiabatique
            droite Neumann_Paroi_adiabatique
            bas Temperature_imposee_paroi Champ_front_uniforme 1 0.
            haut Temperature_imposee_paroi Champ_front_uniforme 1 0.
        }
        initial_conditions { magnetic_field Champ_Fonc_xyz dom 1 sin(pi*y) }
    }
    Convection_Diffusion_K_Magnetic
    {
        diffusion { }
        convection { amont }
        boundary_conditions
        {
            gauche Neumann_Paroi_adiabatique
            droite Neumann_Paroi_adiabatique
            bas Neumann_Paroi_adiabatique
            haut Neumann_Paroi_adiabatique
        }
        initial_conditions { k_b Champ_Uniforme 1 0.5 }
    }
    Convection_Diffusion_Epsilon_Magnetic
    {
        diffusion { }
        convection { amont }
        boundary_conditions
        {
            gauche Neumann_Paroi_adiabatique
            droite Neumann_Paroi_adiabatique
            bas Neumann_Paroi_adiabatique
            haut Neumann_Paroi_adiabatique
        }
        initial_conditions { epsilon_b Champ_Uniforme 1 1. }
    }
}

Solve pb
