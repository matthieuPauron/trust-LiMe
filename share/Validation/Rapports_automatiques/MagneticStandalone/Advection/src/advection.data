# PARALLEL OK #

# ============================================================================= #
# Case C : advection of a magnetic bump by a given velocity (2D/3D template)   #
# ============================================================================= #
# Solves d b / dt + (u.grad) b = 0 (no diffusion: eta = 0) with a uniform     #
# velocity supplied by vitesse_magnetique. An initial Gaussian bump is        #
# transported to the right; peak conserved, centroid moves at U.              #
# CAVEAT: div b != 0 here -- convection-operator test only, not an            #
# admissible magnetic state.                                                  #
# Dimension-specific blocks (mesh, borders, Polyedriser, velocity, BCs,       #
# probes) are injected by the notebook via template substitution.              #
# ============================================================================= #
dimension $dim
Pb_Induction pb
Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave slab
    {
        Origine              $origine
        Nombre_de_Noeuds     $nodes
        Longueurs            $lengths
    }
    {
        $borders
    }
}

$polyedriser
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Associate pb dom

# u = 0.2 m/s, tmax = 1 s -> bump moves from x0 = 0.25 to x ~ 0.45 #
Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 1.
    dt_max 0.01
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    nb_composantes 1
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 0.0
        # uniform rightward velocity #
        vitesse_magnetique     Champ_Uniforme $nvel $vel

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            $bc
        }
        # Gaussian bump centred on x0 = 0.25, sigma = 0.05 #
        initial_conditions
        {
            magnetic_field Champ_Fonc_xyz dom 1 exp(-((x-0.25)^2)/(2*0.05^2))
        }
  }

  Postraitement
  {
    Sondes
    {
      $probes
    }
  }

}

Solve pb
