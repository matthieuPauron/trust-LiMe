# Sequential (high-Rm, 1 rank). #

# High-Rm induction case: advection-dominated transport with turbulent magnetic #
# diffusivity.  u = (1, 0), eta = 1e-3 (Rm ~ 1e3), eta_t = 1e-2 (EDM).       #
# Implicit time + upwind convection for stability at high Peclet.              #
dimension 2
Pb_Induction pb
Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave pave
    {
        Origine              0.  0.
        Nombre_de_Noeuds     $nx $ny
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.
    }
}
# END MESH #

# Sequential run on one rank (high-Rm). #


Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 0.5
    dt_max 0.005
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    nb_composantes 1
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 1e-3
        diffusivite_turbulente_magnetique Champ_Uniforme 1 1e-2
        vitesse_magnetique     Champ_Uniforme 2 1. 0.

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche  Neumann_Paroi_adiabatique
            droite  Neumann_Paroi_adiabatique
            bas     Neumann_Paroi_adiabatique
            haut    Neumann_Paroi_adiabatique
        }
        initial_conditions { magnetic_field Champ_Fonc_xyz dom 1 exp(-((x-0.25)^2)/(2*0.05^2)) }
  }

  Postraitement
  {
    Sondes
    {
      sonde_x025 grav magnetic_field Periode 1e-6 Points 1 0.25 0.5
      sonde_x075 grav magnetic_field Periode 1e-6 Points 1 0.75 0.5
    }
  }
}

Solve pb
