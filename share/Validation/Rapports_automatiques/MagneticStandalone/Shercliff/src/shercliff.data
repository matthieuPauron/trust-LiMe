# PARALLEL OK #

# ============================================================================= #
# Shercliff channel : induced magnetic field and current density (2D/3D)       #
# ============================================================================= #
# One-dimensional physics on a channel with plates at y = +/- 0.5.              #
# The notebook injects the dimension-specific mesh, vectors, boundary conditions #
# and probes into this single validation-form template.                         #
# ============================================================================= #
dimension $dim
Pb_Induction pb
Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave pave
    {
        Origine              $origin
        Nombre_de_Noeuds     $nodes
        Longueurs            $lengths
    }
    {
        $borders
    }
}
$polyedriser
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 25.
    dt_max 0.05
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    nb_composantes $ncomp
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 0.05
        # Parabolic no-slip velocity u_x = U0 (1 - y^2/h^2), U0 = 1, h = 0.5. #
        vitesse_magnetique     Champ_Fonc_xyz dom $dim $velocity

        diffusion  { }
        convection { amont }

        # M1 inductive stretching source S_x = B0 u'_x(y), B0 = 1. #
        sources
        {
            induction_stretching { }
        }

        boundary_conditions
        {
            $magnetic_boundaries
        }
        # Initial field (0, B0) in 2D and (0, B0, 0) in 3D. #
        initial_conditions { magnetic_field Champ_Uniforme $ncomp $initial_field }
    }

    Postraitement
    {
        Sondes
        {
            $probes
        }
    }
}

Solve pb
