# PARALLEL OK #

# ============================================================================= #
# Case B : decay of a magnetic Fourier mode  (TRUST-LiMe standalone MHD) #
# ============================================================================= #
# Solves the pure diffusion of a transverse magnetic mode with Dirichlet #
# conditions in Y and zero-flux conditions in X:                           #
#     b(x,y,t) = A sin(k y) exp(-eta k^2 t) ,  k = pi / Ly                 #
# Only component 0 (the transverse field Bx) transported; u = 0.           #
# Exact analytic solution known; decay rate measures discretised eta.      #
# ============================================================================= #
dimension 2
Pb_Induction pb
Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave pavé
    {
        Origine              0.  0.
        Nombre_de_Noeuds     $nx $ny
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.
    }
}
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 1.
    dt_max 0.01
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    nb_composantes 1
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 0.05
        # no vitesse_magnetique -> u = 0, pure diffusion #

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche  Neumann_Paroi_adiabatique
            droite  Neumann_Paroi_adiabatique
            bas     Temperature_imposee_paroi Champ_front_uniforme 1 0.
            haut    Temperature_imposee_paroi Champ_front_uniforme 1 0.
        }
        initial_conditions { magnetic_field Champ_Fonc_xyz dom 1 sin(pi*y) }
  }

  Postraitement
  {
    Sondes
    {
      sonde_y025 grav magnetic_field Periode 1e-6 Points 1 0.5 0.25
      sonde_y050 grav magnetic_field Periode 1e-6 Points 1 0.5 0.50
      sonde_y075 grav magnetic_field Periode 1e-6 Points 1 0.5 0.75
    }
  }
  
}

Solve pb
