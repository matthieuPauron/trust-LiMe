# PARALLEL OK #
/* Shared 2D/3D template; the notebook injects dimension-specific blocks. */

# ============================================================================= #
# Case H : Hartmann 1D - induced field of the Hartmann flow                 #
# ============================================================================= #
# TRUST-LiMe standalone MHD: d b / d t + (u . grad) b - div(eta grad b) =   #
# (b.grad) u.                                                                 #
#                                                                             #
# One-dimensional physics on a 2D mesh: plates at y = +/- h (h = 0.5), all   #
# fields depend on y only. The velocity is the analytic Hartmann profile    #
# (Hartmann number Ha = 5, no-slip at the walls):                            #
#     u(y) = U0 (cosh(Ha) - cosh(Ha y/h)) / (cosh(Ha) - 1),   u = (u, 0).     #
# The module has no momentum equation: the profile is prescribed as data and #
# the induced magnetic field is what is validated.                           #
#                                                                             #
# With the applied field b_y = B0 = 1 along y, the M1 source is S_x = B0 u'(y) #
# and the steady equation (S enters the right-hand side, so eta b'' = -S) is  #
#     eta b_x''(y) = -B0 u'(y),   b_x'(+/-h) = 0   (insulating walls),        #
# whose mean-free solution is the ODD profile                                #
#     b_x(y) = -(B0/eta) [ Int_{-h}^{y} u dy' - (1/2) Int_{-h}^{h} u dy' ].   #
# b_y = B0 is an exact equilibrium of the full system (S_y = 0).             #
#                                                                             #
# Initial state b = (0, B0): the mean of b_x is conserved (zero-flux walls,   #
# u(+/-h) = 0), so the flow relaxes onto that mean-free analytic profile.    #
# Probes sit exactly on cell centres (dyadic rationals); the core probes     #
# give a tight comparison, the wall-layer probes only a bounded one (the      #
# module's frozen-velocity gradient is only first-order accurate in the two  #
# cells adjacent to a wall - see Hartmann1D.ipynb and KERNEL_REUSE_NOTES).    #
# ============================================================================= #
dimension $dim
Pb_Induction pb
Domaine dom

# plates at y = +/- 0.5 : walls are the two bords normal to Y #

# BEGIN MESH #
$mesh_block
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 25.
    dt_max 0.05
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    # vector model: b = (b_x induced, B0 applied) #
    nb_composantes 2
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 0.05
        # Hartmann profile u(y) = U0 (cosh(Ha) - cosh(Ha y/h)) / (cosh(Ha) - 1) #
$velocity_line

        diffusion  { }
        convection { amont }

        # M1 inductive stretching source S = (b.grad) u : S_x = B0 u'(y) #
        sources
        {
            induction_stretching { }
        }

        $boundary_block
        # b = (0, B0) initially : the induced field grows from zero #
        initial_conditions { magnetic_field Champ_Uniforme 2 0. 1. }
    }

  $post_block

}

Solve pb
