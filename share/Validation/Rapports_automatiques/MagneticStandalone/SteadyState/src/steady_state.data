# PARALLEL OK #

# ============================================================================= #
# Case E : steady state with a spatially varying diffusivity #
# ============================================================================= #
# b(x,y) = y with eta = eta(x) = 1 + x is an exact steady equilibrium:     #
# div(eta grad b) = d/dy(1+x) = 0 and u = 0. Any spurious source, a        #
# mis-assembled diffusion operator or a badly interpolated varying eta     #
# would destroy this equilibrium.                                          #
# ============================================================================= #
dimension 2
Pb_MHD pb
Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave pavé
    {
        Origine              0.  0.
        Nombre_de_Noeuds     33  33
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.
    }
}
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Associate pb dom

# long run with small diffusivity: residual drift accumulates visibly #
Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 2.
    dt_max 0.02
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    nb_composantes 1
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        # SPATIALLY VARYING diffusivity eta = 1 + x (functional field) #
        diffusivite_magnetique Champ_Fonc_xyz dom 1 1+x

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            # b = y prescribed on the two faces normal to Y #
            bas     Temperature_imposee_paroi Champ_front_uniforme 1 0.
            haut    Temperature_imposee_paroi Champ_front_uniforme 1 1.
            # zero flux on the faces normal to X (b does not depend on x) #
            gauche  Neumann_Paroi_adiabatique
            droite  Neumann_Paroi_adiabatique
        }
        initial_conditions { magnetic_field Champ_Fonc_xyz dom 1 y }
  }

  Postraitement
  {
    Sondes
    {
      # b = y -> probes read 0.25 / 0.5 / 0.75 at all times #
      sonde_y025 grav magnetic_field Periode 1e-6 Points 1 0.5 0.25
      sonde_y050 grav magnetic_field Periode 1e-6 Points 1 0.5 0.50
      sonde_y075 grav magnetic_field Periode 1e-6 Points 1 0.5 0.75
    }
  }
  
}

Solve pb
