# PARALLEL OK #
/* Shared 2D/3D template; the notebook injects dimension-specific blocks. */

# ============================================================================= #
# Case E : steady state with a spatially varying diffusivity #
# ============================================================================= #
# b(x,y) = y with eta = eta(x) = 1 + x is an exact steady equilibrium:     #
# div(eta grad b) = d/dy(1+x) = 0 and u = 0. Any spurious source, a        #
# mis-assembled diffusion operator or a badly interpolated varying eta     #
# would destroy this equilibrium.                                          #
# ============================================================================= #
dimension $dim
Pb_Induction pb
Domaine dom

# BEGIN MESH #
$mesh_block
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Associate pb dom

# long run with small diffusivity: residual drift accumulates visibly #
Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 2.
    dt_max 0.02
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    nb_composantes 1
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        # SPATIALLY VARYING diffusivity eta = 1 + x (functional field) #
        diffusivite_magnetique Champ_Fonc_xyz dom 1 1+x

        diffusion  { }
        convection { amont }

        $boundary_block
        initial_conditions { magnetic_field Champ_Fonc_xyz dom 1 y }
  }

  $post_block
  
}

Solve pb
