# PARALLEL OK #

# ============================================================================= #
# Coupled low-Rm MHD : MMS Lorentz-force hydrostatic balance  (TRUST-LiMe)     #
# ============================================================================= #
# Pb_MHD with TWO equations: the magnetic induction equation and a              #
# Navier-Stokes equation coupled by the 'force_lorentz' source (J x B,          #
# per unit mass, lagged b).                                                     #
#                                                                               #
# Magnetic field b = (y, -x) (exactly linear, eta = 0, no transport velocity):   #
#     curl b = -2  =>  J = (0,0,-2)/mu0                                         #
#     F = J x b = -2(x,y,0)/mu0^2      (mu0 = 1, rho = 1)                       #
#                                                                               #
# F is a pure gradient (curl-free), so the EXACT steady solution of the         #
# momentum equation in the closed box is:                                       #
#     u = 0,   p = -(x^2 + y^2)/mu0^2 rho + C                                   #
# i.e. a Lorentz "hydrostatic" balance.  The velocity probes must stay at       #
# zero and the pressure difference between two interior cell centres must       #
# match -Delta(x^2 + y^2):                                                      #
#     p(0.65,0.65) - p(0.35,0.35) = -(0.65^2+0.65^2-0.35^2-0.35^2) = -0.60     #
# (mu0 = rho = 1; probes at cell centres, interior cells only —                  #
# the Green-Gauss grad(b) is exact there, O(h) next to the walls).              #
# ============================================================================= #
dimension 2
Pb_MHD pb
Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave pave
    {
        Origine              0.  0.
        Nombre_de_Noeuds     11  11
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.
    }
}
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 0.5
    dt_max 0.05
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    # Vector model: the Lorentz force requires the full vector b. #
    nb_composantes 2
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    # Optional momentum equation: presence => coupled low-Rm mode. #
    Navier_Stokes_standard
    {
        # Pressure solver: Petsc-wrapped direct solver (the Sparskit-based #
        # direct solver is deprecated and unstable here).                   #
        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche  paroi_fixe
            droite   paroi_fixe
            bas     paroi_fixe
            haut    paroi_fixe
        }
        initial_conditions
        {
            vitesse Champ_Uniforme 2 0. 0.
        }
        sources
        {
            force_lorentz { }
        }
    }

    Convection_Diffusion_Magnetic_field
    {
        # eta = 0 and no transport velocity: b = (y,-x) is an exact equilibrium. #
        diffusivite_magnetique Champ_Uniforme 1 0.

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche  Neumann_Paroi_adiabatique
            droite   Neumann_Paroi_adiabatique
            bas     Neumann_Paroi_adiabatique
            haut    Neumann_Paroi_adiabatique
        }
        # exactly linear vector field b = (y, -x) #
        initial_conditions { magnetic_field Champ_Fonc_xyz dom 2 y -x }
    }

    Postraitement
    {
        Sondes
        {
            # interior cell centres, off the partition joint (x=0.5): u must stay 0 #
            sonde_u grav vitesse Periode 1e-6 Points 2 0.35 0.35  0.35 0.65
            # pressure difference checks the Lorentz hydrostatic balance #
            sonde_p1 grav pression Periode 1e-6 Points 1 0.35 0.35
            sonde_p2 grav pression Periode 1e-6 Points 1 0.65 0.65
        }
    }

}

Solve pb
