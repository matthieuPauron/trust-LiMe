# PARALLEL OK #

# ============================================================================= #
# Post-treatment field : tension_magnetique  (TRUST-LiMe standalone MHD) #
# ============================================================================= #
# Magnetic tension force density Ft = (1/mu0) (b . grad) b, built from the #
# element-wise gradient of b (Green-Gauss reconstruction — the kernel has no #
# element-field gradient factory on PolyMAC).                                 #
# Vector model: b = (y, x) (exactly linear field, so the reconstructed      #
# gradient is exact at every cell centre):                                    #
#     grad b = [[0, 1], [1, 0]]  =>  Ft = (x, y) with mu0 = 1.                #
# Probe at the cell centre (0.45, 0.55): Ft = (0.45, 0.55) exactly.          #
# ============================================================================= #
dimension 2
Pb_MHD pb
Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave pave
    {
        Origine              0.  0.
        Nombre_de_Noeuds     11  11
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.
    }
}
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 0.05
    dt_max 0.02
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    # Vector model: both magnetic components transported. #
    # tension_magnetique rejects the scalar model with a clear error. #
    nb_composantes 2
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        # eta = 0 and no velocity: the linear field is an exact equilibrium. #
        diffusivite_magnetique Champ_Uniforme 1 0.

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche  Neumann_Paroi_adiabatique
            droite  Neumann_Paroi_adiabatique
            bas     Neumann_Paroi_adiabatique
            haut    Neumann_Paroi_adiabatique
        }
        # exactly linear vector field b = (y, x) #
        initial_conditions { magnetic_field Champ_Fonc_xyz dom 2 y x }
  }

  Postraitement
  {
    Sondes
    {
      # probe snapped to the cell centre (0.45, 0.55): Ft = (0.45, 0.55) #
      sonde_ft grav tension_magnetique Periode 1e-6 Points 1 0.45 0.55
    }
  }

}

Solve pb
