# PARALLEL OK #

# ============================================================================= #
# Post-treatment field : courant_magnetique, 3D vector form (TRUST-LiMe)        #
# ============================================================================= #
# Merged form (post-treatment merge), 3D gradient dataset.                      #
# The electric current density is the only post-treatment field whose 2D        #
# image (a single out-of-plane scalar J_z) does not exercise the full           #
# vector branch of mhd_courant_magnetique(): the 3D case keeps that coverage.   #
#                                                                               #
#   b = (y, z, x) exactly linear  =>  curl b = (-1, -1, -1)                     #
#   mu0 = 2.0 (non-default, so a formula ignoring the mu0 keyword is caught)    #
#     => J = curl b / mu0 = (-0.5, -0.5, -0.5)                                  #
#   eta = 0 and no velocity: the linear field is an exact equilibrium.          #
# ============================================================================= #
dimension 3
Pb_MHD pb
Domaine dom

# PolyMAC_MPFA works on polyhedra: convert the Pave hexahedra (3D only) #

# BEGIN MESH #
Mailler dom
{
    Pave pave
    {
        Origine              0.  0.  0.
        Nombre_de_Noeuds     $nx $ny $nz
        Longueurs            1.  1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.  0. <= Z <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.  0. <= Z <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.  0. <= Z <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.  0. <= Z <= 1.
        Bord devant   Z = 0.    0. <= X <= 1.  0. <= Y <= 1.
        Bord derriere Z = 1.    0. <= X <= 1.  0. <= Y <= 1.
    }
}
Polyedriser dom
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 0.05
    dt_max 0.02
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    # Vector model: differential fields require the full vector b. #
    nb_composantes 3
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        # eta = 0 and no velocity: the linear field is an exact equilibrium. #
        diffusivite_magnetique Champ_Uniforme 1 0.
        mu0 2.0

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche   Neumann_Paroi_adiabatique
            droite   Neumann_Paroi_adiabatique
            bas      Neumann_Paroi_adiabatique
            haut     Neumann_Paroi_adiabatique
            devant   Neumann_Paroi_adiabatique
            derriere Neumann_Paroi_adiabatique
        }
        # exactly linear vector field b = (y, z, x) #
        initial_conditions { magnetic_field Champ_Fonc_xyz dom 3 y z x }
  }

  Postraitement
  {
    Sondes
    {
      # probe snapped to the cell centre (0.375, 0.375, 0.375) #
      sonde_j grav courant_magnetique Periode 1e-6 Points 1 0.375 0.375 0.375
    }
  }

}

Solve pb
