# PARALLEL OK #

# ============================================================================= #
# Post-treatment fields : the transport family (TRUST-LiMe standalone MHD)      #
# ============================================================================= #
# Merged form (post-treatment merge): one run carries the six fields that       #
# read the frozen transport velocity u and/or the material parameters:          #
#     vecteur_poynting, helicite_croisee, nombre_de_reynolds_magnetique,        #
#     nombre_de_prandtl_magnetique, energie_magnetique,                         #
#     pulsation_cyclotronique                                                   #
#                                                                               #
# DESIGN: uniform b = (3, 4) and uniform u = (4, 3) => (u.grad) b = 0 and       #
# grad^2 b = 0, so b is an exact discrete equilibrium at every cell (wall       #
# cells included) and every reference below is position-independent.            #
#                                                                               #
# |b| = |u| = 5 exactly, and every reference is an integer or a terminating     #
# decimal, so each one is represented EXACTLY by the 9 significant digits       #
# that a TRUST .son probe file stores (a value such as 2*sqrt(5) would be       #
# truncated and no machine-precision assertion could hold).                     #
#                                                                               #
#   mu0 = 2, q/m = 2, mu = 2, rho = 4 (=> nu = mu/rho = 0.5), eta = 0.25:       #
#     S       = (|b|^2 u - (u.b) b)/mu0 = (25*(4,3) - 24*(3,4))/2               #
#                                     = (14, -10.5)                             #
#     h_c     = u.b                    = 3*4 + 4*3   = 24                       #
#     Rm      = |u| L_e / eta          = 5 * h / 0.25 = 20 h                    #
#     Pm      = nu / eta               = 0.5 / 0.25  = 2                        #
#     e_m     = |b|^2 / (2 mu0)        = 25 / 4      = 6.25                     #
#     omega_c = (q/m) |b|              = 2 * 5       = 10                       #
#                                                                               #
# b and u are deliberately NOT parallel (u.b = 24, b x u = -7): a parallel      #
# pair would make the Poynting vector vanish, and an orthogonal pair            #
# (u.b = 0) would make the crossed helicity vanish.                             #
#                                                                               #
# Every constant above is deliberately NON-default (mu0, q/m, mu, rho, eta)     #
# so that a formula with a hard-coded 1.0 cannot pass.                          #
# ============================================================================= #
dimension 2
Pb_MHD pb
Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave pave
    {
        Origine              0.  0.
        Nombre_de_Noeuds     $nx $ny
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.
    }
}
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 0.05
    dt_max 0.02
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    # Vector model: both magnetic components transported #
    nb_composantes 2
    fluide_incompressible
    {
        # nu = mu / rho = 0.5 (used by nombre_de_prandtl_magnetique) #
        mu      Champ_Uniforme 1 2.0
        rho     Champ_Uniforme 1 4.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 0.25
        # non-default permeability and charge-to-mass ratio #
        mu0 2.0
        rapport_charge_masse 2.0
        # frozen transport velocity: u = (4, 3) #
        vitesse_magnetique     Champ_Uniforme 2 4. 3.

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche  Neumann_Paroi_adiabatique
            droite  Neumann_Paroi_adiabatique
            bas     Neumann_Paroi_adiabatique
            haut    Neumann_Paroi_adiabatique
        }
        # uniform vector field b = (3, 4) #
        initial_conditions { magnetic_field Champ_Uniforme 2 3. 4. }
  }

  Postraitement
  {
    Sondes
    {
      # single interior probe: every reference is position-independent #
      sonde_poynting grav vecteur_poynting            Periode 1e-6 Points 1 0.45 0.55
      sonde_hc       grav helicite_croisee            Periode 1e-6 Points 1 0.45 0.55
      sonde_rm       grav nombre_de_reynolds_magnetique Periode 1e-6 Points 1 0.45 0.55
      sonde_pm       grav nombre_de_prandtl_magnetique  Periode 1e-6 Points 1 0.45 0.55
      sonde_em       grav energie_magnetique          Periode 1e-6 Points 1 0.45 0.55
      sonde_omega    grav pulsation_cyclotronique     Periode 1e-6 Points 1 0.45 0.55
    }
  }

}

Solve pb
