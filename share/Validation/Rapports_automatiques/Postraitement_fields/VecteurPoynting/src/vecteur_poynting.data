# PARALLEL OK #

# ============================================================================= #
# Post-treatment field : vecteur_poynting  (TRUST-LiMe standalone MHD) #
# ============================================================================= #
# Ideal-MHD Poynting vector built from the frozen velocity u (E = -u x b):   #
#     S = (1/mu0) ( |b|^2 u - (u.b) b )                                      #
# Uniform b = (1, 2), u = (3, 4), mu0 = 1 : |b|^2 = 5, u.b = 11 => S =      #
# (5*3 - 11*1, 5*4 - 11*2) = (4, -2) everywhere.                             #
# ============================================================================= #
dimension 2
Pb_MHD pb
Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave pave
    {
        Origine              0.  0.
        Nombre_de_Noeuds     11  11
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.
    }
}
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 0.05
    dt_max 0.02
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    # Vector model: both magnetic components transported #
    nb_composantes 2
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 1.0
        vitesse_magnetique     Champ_Uniforme 2 3. 4.

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche  Neumann_Paroi_adiabatique
            droite  Neumann_Paroi_adiabatique
            bas     Neumann_Paroi_adiabatique
            haut    Neumann_Paroi_adiabatique
        }
        # uniform vector field b = (1, 2) : S = (4, -2) #
        initial_conditions { magnetic_field Champ_Uniforme 2 1. 2. }
  }

  Postraitement
  {
    Sondes
    {
      sonde_poynting grav vecteur_poynting Periode 1e-6 Points 1 0.45 0.55
    }
  }

}

Solve pb
