# ============================================================================= #
# Post-treatment field : helicite_croisee  (TRUST-LiMe standalone MHD) #
# ============================================================================= #
# Crossed helicity density h_c = u . b. Uniform b = (1, 2), u = (3, 4) =>   #
# h_c = 1*3 + 2*4 = 11 everywhere.                                           #
# ============================================================================= #
dimension 2
Pb_MHD pb
Domaine dom

Mailler dom
{
    Pave pave
    {
        Origine              0.  0.
        Nombre_de_Noeuds     11  11
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.
    }
}

Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 0.05
    dt_max 0.02
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    # Vector model: both magnetic components transported #
    nb_composantes 2
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 1.0
        vitesse_magnetique     Champ_Uniforme 2 3. 4.

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche  Neumann_Paroi_adiabatique
            droite  Neumann_Paroi_adiabatique
            bas     Neumann_Paroi_adiabatique
            haut    Neumann_Paroi_adiabatique
        }
        # uniform vector field b = (1, 2) : h_c = u.b = 11 #
        initial_conditions { magnetic_field Champ_Uniforme 2 1. 2. }
  }

  Postraitement
  {
    Sondes
    {
      sonde_hc grav helicite_croisee Periode 1e-6 Points 1 0.45 0.55
    }
  }

}

Solve pb
