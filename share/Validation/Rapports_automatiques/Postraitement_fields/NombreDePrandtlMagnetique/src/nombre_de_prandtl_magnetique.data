# ============================================================================= #
# Post-treatment field : nombre_de_prandtl_magnetique  (TRUST-LiMe MHD) #
# ============================================================================= #
# Magnetic Prandtl number Pm = nu / eta. Fluid given as usmu (dynamic       #
# viscosity) mu = 2 and rho = 4 => nu = mu / rho = 0.5; eta = 0.25 =>       #
# Pm = 2 everywhere.                                                         #
# ============================================================================= #
dimension 2
Pb_MHD pb
Domaine dom

Mailler dom
{
    Pave pave
    {
        Origine              0.  0.
        Nombre_de_Noeuds     11  11
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.
    }
}

Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 0.05
    dt_max 0.02
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    nb_composantes 1
    fluide_incompressible
    {
        # nu = mu / rho = 2 / 4 = 0.5 #
        mu      Champ_Uniforme 1 2.0
        rho     Champ_Uniforme 1 4.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 0.25

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche  Neumann_Paroi_adiabatique
            droite  Neumann_Paroi_adiabatique
            bas     Neumann_Paroi_adiabatique
            haut    Neumann_Paroi_adiabatique
        }
        initial_conditions { magnetic_field Champ_Uniforme 1 1.0 }
  }

  Postraitement
  {
    Sondes
    {
      sonde_pm grav nombre_de_prandtl_magnetique Periode 1e-6 Points 1 0.45 0.55
    }
  }

}

Solve pb
