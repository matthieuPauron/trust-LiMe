# PARALLEL OK #

# ============================================================================= #
# Case G (3D) : induction source term S = (b.grad) u  (TRUST-LiMe standalone) #
# ============================================================================= #
# 3D counterpart of MagneticStandalone/SourceStretching. Exercises the M1    #
# source `induction_stretching` (adds S = (b.grad) u).                        #
# u = (x, -y, 0) (div u = 0) => grad u = diag(1,-1,0); with a uniform b:     #
#     d b / dt = b  =>  b(t) = B0 exp(t)                                    #
# Sharp absolute check of the source magnitude and sign in 3D (this is the   #
# first 3D exercise of the grad_u auxiliary-variables path).                #
# ============================================================================= #
dimension 3
Pb_MHD pb
Domaine dom

# PolyMAC_MPFA works on polyhedra: convert the Pave hexahedra (3D only) #

# BEGIN MESH #
Mailler dom
{
    Pave cube
    {
        Origine              0.  0.  0.
        Nombre_de_Noeuds     $nx $ny $nz
        Longueurs            1.  1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.  0. <= Z <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.  0. <= Z <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.  0. <= Z <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.  0. <= Z <= 1.
        Bord devant   Z = 0.    0. <= X <= 1.  0. <= Y <= 1.
        Bord derriere Z = 1.    0. <= X <= 1.  0. <= Y <= 1.
    }
}

Polyedriser dom
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Associate pb dom

# tmax = 0.5 -> b0 grows from 1 to exp(0.5) ~ 1.6487 #
Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 0.5
    dt_max 0.002
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    # Scalar field: the module transports a single magnetic component #
    nb_composantes 1
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 0.0
        # u = (x, -y, 0) : divergence-free velocity, du_x/dx = 1, constant gradient #
        vitesse_magnetique     Champ_Fonc_xyz dom 3 x -y 0.

        diffusion  { }
        convection { amont }

        # M1 inductive stretching source term #
        sources
        {
            induction_stretching { }
        }

        boundary_conditions
        {
            # b is uniform, so zero-flux everywhere is consistent #
            gauche   Neumann_Paroi_adiabatique
            droite   Neumann_Paroi_adiabatique
            bas      Neumann_Paroi_adiabatique
            haut     Neumann_Paroi_adiabatique
            devant   Neumann_Paroi_adiabatique
            derriere Neumann_Paroi_adiabatique
        }
        # uniform scalar initial field b = B0 #
        initial_conditions { magnetic_field Champ_Uniforme 1 1.0 }
  }

  Postraitement
  {
    Sondes
    {
      # the transported scalar field must follow exp(t) #
      sonde_b0 grav magnetic_field Periode 1e-6 Points 1 0.5 0.5 0.5
    }
  }

}

Solve pb
