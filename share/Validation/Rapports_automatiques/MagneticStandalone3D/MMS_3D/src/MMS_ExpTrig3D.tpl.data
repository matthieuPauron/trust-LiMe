# PARALLEL OK #

Dimension 3

Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave pavé
    {
        Origine              0.  0.  0.
        Nombre_de_Noeuds     $nx $ny $nz
        Longueurs            1.  1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.  0. <= Z <= 1.
        Bord droit    X = 1.    0. <= Y <= 1.  0. <= Z <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.  0. <= Z <= 1.
        Bord avant    Z = 0.    0. <= X <= 1.  0. <= Y <= 1.
        Bord arriere   Z = 1.    0. <= X <= 1.  0. <= Y <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.  0. <= Z <= 1.
    }
}
Polyedriser dom
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 0.1
    dt_impr 0.05
    dt_min 1.e-6
    dt_max 0.05
    seuil_statio 1.e-12
    facsec 1.0
    nb_pas_dt_max 2
    solveur implicite { solveur gmres { diag seuil 1.e-12 nb_it_max 100 } }
}

Pb_MHD pbmhd
Associate pbmhd dom
Associate pbmhd sch
Discretize pbmhd dis

Read pbmhd
{
    nb_composantes 1
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 0.01
        convection { amont }
        diffusion { }
        vitesse_magnetique Champ_Uniforme 3 0. 0. 0.
        initial_conditions { magnetic_field Champ_Fonc_xyz dom 1 sin(pi*x)*exp(-y) }
        boundary_conditions {
            gauche  Neumann_Paroi_adiabatique
            droit   Neumann_Paroi_adiabatique
            bas     Neumann_Paroi_adiabatique
            avant   Neumann_Paroi_adiabatique
            arriere Neumann_Paroi_adiabatique
            haut    Neumann_Paroi_adiabatique
        }
    }
    Postraitement
    {
        Sondes
        {
            sonde_y025 grav magnetic_field Periode 1e-6 Points 1 0.5 0.25 0.5
            sonde_y050 grav magnetic_field Periode 1e-6 Points 1 0.5 0.50 0.5
            sonde_y075 grav magnetic_field Periode 1e-6 Points 1 0.5 0.75 0.5
        }
        Champs dt_post 0.1 { magnetic_field elem }
    }
}
Solve pbmhd
