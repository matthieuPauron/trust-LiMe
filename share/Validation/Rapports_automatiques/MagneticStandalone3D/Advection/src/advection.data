# ============================================================================= #
# Case C (3D) : advection of a magnetic bump by a given velocity              #
# ============================================================================= #
# 3D counterpart of MagneticStandalone/Advection. Solves                       #
# d b / dt + (u.grad) b = 0 (no diffusion: eta = 0) with a uniform            #
# velocity u = (U, 0, 0). An initial Gaussian bump (uniform in Y and Z)      #
# is transported along x; peak conserved, centroid moves at U.               #
# CAVEAT: div b != 0 here -- convection-operator test only, not an          #
# admissible magnetic state.                                                #
# ============================================================================= #
dimension 3
Pb_MHD pb
Domaine dom

Mailler dom
{
    Pave slab
    {
        # keep the 2D resolution along the transport direction, coarse in Y/Z #
        Origine              0.  0.  0.
        Nombre_de_Noeuds     65  9  9
        Longueurs            1.  1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.  0. <= Z <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.  0. <= Z <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.  0. <= Z <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.  0. <= Z <= 1.
        Bord devant   Z = 0.    0. <= X <= 1.  0. <= Y <= 1.
        Bord derriere Z = 1.    0. <= X <= 1.  0. <= Y <= 1.
    }
}

# PolyMAC_MPFA works on polyhedra: convert the Pave hexahedra (3D only) #
Polyedriser dom

Polymac_p0 dis

Associate pb dom

# u = 0.2 m/s, tmax = 1 s -> bump moves from x0 = 0.25 to x ~ 0.45 #
Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 1.
    dt_max 0.01
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    nb_composantes 1
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 0.0
        # uniform rightward velocity u = (0.2, 0, 0) #
        vitesse_magnetique     Champ_Uniforme 3 0.2 0. 0.

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            # homogeneous Neumann everywhere (bump stays away from walls) #
            gauche   Neumann_Paroi_adiabatique
            droite   Neumann_Paroi_adiabatique
            bas      Neumann_Paroi_adiabatique
            haut     Neumann_Paroi_adiabatique
            devant   Neumann_Paroi_adiabatique
            derriere Neumann_Paroi_adiabatique
        }
        # Gaussian bump centred on x0 = 0.25, sigma = 0.05, uniform in Y and Z #
        initial_conditions
        {
            magnetic_field Champ_Fonc_xyz dom 1 exp(-((x-0.25)^2)/(2*0.05^2))
        }
  }

  Postraitement
  {
    Sondes
    {
      # field along the bump trajectory at mid-height, mid-depth #
      sonde_x015 grav magnetic_field Periode 1e-6 Points 1 0.15 0.5 0.5
      sonde_x025 grav magnetic_field Periode 1e-6 Points 1 0.25 0.5 0.5
      sonde_x045 grav magnetic_field Periode 1e-6 Points 1 0.45 0.5 0.5
    }
  }

}

Solve pb
