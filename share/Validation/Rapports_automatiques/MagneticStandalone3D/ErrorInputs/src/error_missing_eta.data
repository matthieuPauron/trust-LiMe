# PARALLEL OK #

# ============================================================================= #
# Case A (3D, negative) : missing diffusivite_magnetique must fail           #
# ============================================================================= #
# 3D counterpart of MagneticStandalone/ErrorMissingEta. The magnetic         #
# diffusivity keyword is deliberately omitted: must fail cleanly with        #
# a readable message.                                                       #
# ============================================================================= #

dimension 3
Pb_MHD pb
Domaine dom

# --------------------------------- mesh ------------------------------------ #

# BEGIN MESH #
Mailler dom
{
    Pave cube
    {
        /* fail-fast case: a coarse mesh is enough */
        Origine              0.  0.  0.
        Nombre_de_Noeuds     9  9  9
        Longueurs            1.  1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.  0. <= Z <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.  0. <= Z <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.  0. <= Z <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.  0. <= Z <= 1.
        Bord devant   Z = 0.    0. <= X <= 1.  0. <= Y <= 1.
        Bord derriere Z = 1.    0. <= X <= 1.  0. <= Y <= 1.
    }
}

Polyedriser dom
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


# ------------------------------- discretisation ------------------------------ #
Polymac_p0 dis

Associate pb dom

# ------------------------------ time integration ---------------------------- #
Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 1.
    dt_max 0.05
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

# ---------------------------------- physics --------------------------------- #
Read pb
{
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        nb_composantes         1
        # diffusivite_magnetique DELIBERATELY MISSING -> must fail cleanly #

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            Bord gauche   Neumann_Paroi_adiabatique
            Bord droite   Neumann_Paroi_adiabatique
            Bord bas      Neumann_Paroi_adiabatique
            Bord haut     Neumann_Paroi_adiabatique
            Bord devant   Neumann_Paroi_adiabatique
            Bord derriere Neumann_Paroi_adiabatique
        }
        initial_conditions { magnetic_field Champ_Uniforme 1 3.0 }
    }
}

# --------------------------------- postprocessing --------------------------- #
Postraitement
{
    Sondes
    {
        sonde_cbx grav magnetic_field Periode dts Points 1 0.5 0.5 0.5
    }
}

Solve pb
