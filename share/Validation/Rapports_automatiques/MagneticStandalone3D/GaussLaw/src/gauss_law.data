# 3D extrusion of the 2D GaussLaw case: clean a compatible non-solenoidal field. #
dimension 3
Pb_Induction pb
Domaine dom

Mailler dom
{
    Pave pavé
    {
        Origine              0.  0.  0.
        Nombre_de_Noeuds     $nx 4 4
        Longueurs            1.  1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.  0. <= Z <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.  0. <= Z <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.  0. <= Z <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.  0. <= Z <= 1.
        Bord devant   Z = 0.    0. <= X <= 1.  0. <= Y <= 1.
        Bord derriere Z = 1.    0. <= X <= 1.  0. <= Y <= 1.
    }
}
Polyedriser dom

Polymac_p0 dis
Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 1.
    dt_max 0.01
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    nb_composantes 3
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        correction_divergence { solveur_divergence Petsc Gmres { precond diag { } } frequence_correction 1 seuil_divergence 1e-8 }
        diffusivite_magnetique Champ_Uniforme 1 0.05
        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche   Neumann_Paroi_adiabatique
            droite   Neumann_Paroi_adiabatique
            bas      Neumann_Paroi_adiabatique
            haut     Neumann_Paroi_adiabatique
            devant   Neumann_Paroi_adiabatique
            derriere Neumann_Paroi_adiabatique
        }
        initial_conditions { magnetic_field Champ_Fonc_xyz dom 3 x*(1-x) 0. 0. }
    }

    Postraitement
    {
        Sondes
        {
            sonde_div_1 grav divergence_magnetique Periode 1e-6 Points 1 0.25 0.50 0.50
            sonde_div_2 grav divergence_magnetique Periode 1e-6 Points 1 0.50 0.50 0.50
            sonde_div_3 grav divergence_magnetique Periode 1e-6 Points 1 0.75 0.50 0.50
        }
    }
}

Solve pb
