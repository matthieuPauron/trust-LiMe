# ============================================================================= #
# Case F (3D) : spatially varying velocity, uniform field stays uniform      #
# ============================================================================= #
# 3D counterpart of MagneticStandalone/VaryingVelocity. Exercises the        #
# vitesse_magnetique reading path with a functional velocity                 #
# (Champ_Fonc_xyz). With uniform b = b0, (u.grad) b = 0 and diffusion 0 (on  #
# a uniform field), so b must remain b0 exactly, whatever u. Velocity:       #
# vortex u = (-y, x, 0) (div-free).                                         #
# ============================================================================= #
dimension 3
Pb_MHD pb
Domaine dom

Mailler dom
{
    Pave cube
    {
        Origine              0.  0.  0.
        Nombre_de_Noeuds     17  17  17
        Longueurs            1.  1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.  0. <= Z <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.  0. <= Z <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.  0. <= Z <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.  0. <= Z <= 1.
        Bord devant   Z = 0.    0. <= X <= 1.  0. <= Y <= 1.
        Bord derriere Z = 1.    0. <= X <= 1.  0. <= Y <= 1.
    }
}

# PolyMAC_MPFA works on polyhedra: convert the Pave hexahedra (3D only) #
Polyedriser dom

Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 1.
    dt_max 0.02
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    nb_composantes 1
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 1.0
        # strongly varying vortex velocity u = (-y, x, 0) #
        vitesse_magnetique     Champ_Fonc_xyz dom 3 -y x 0.

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche   Neumann_Paroi_adiabatique
            droite   Neumann_Paroi_adiabatique
            bas      Neumann_Paroi_adiabatique
            haut     Neumann_Paroi_adiabatique
            devant   Neumann_Paroi_adiabatique
            derriere Neumann_Paroi_adiabatique
        }
        initial_conditions { magnetic_field Champ_Uniforme 1 3.0 }
  }

  Postraitement
  {
    Sondes
    {
      sonde_cbx grav magnetic_field Periode 1e-6 Points 1 0.5 0.5 0.5
    }
  }

}

Solve pb
