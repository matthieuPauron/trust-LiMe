# ============================================================================= #
# Coupled low-Rm MHD : Lorentz-force hydrostatic balance  (TRUST-LiMe)          #
# ============================================================================= #
# Pb_MHD with TWO equations: the magnetic induction equation and a              #
# Navier-Stokes equation coupled by the 'force_lorentz' source (J x B,          #
# per unit mass, lagged b).                                                     #
#                                                                               #
# Magnetic field b = (y, 0) (exactly linear, eta = 0, no transport velocity):   #
#     curl b = -1  =>  J = (0,0,-1)/mu0                                         #
#     F = J x b = (0,-y,0)/mu0^2      (mu0 = 1, rho = 1)                        #
#                                                                               #
# F is a pure gradient (curl-free), so the EXACT steady solution of the         #
# momentum equation in the closed box is:                                       #
#     u = 0,   p = -y^2/(2 mu0^2 rho) + C                                       #
# i.e. a Lorentz "hydrostatic" balance.  The velocity probes must stay at       #
# zero and the pressure difference between two interior cell centres must       #
# match -Delta(y^2/2):                                                          #
#     p(0.75) - p(0.45) = -(0.75^2 - 0.45^2)/2 = -0.18                          #
# (mu0 = rho = 1; 11x11 cells, probes at cell centres, interior cells only —    #
# the Green-Gauss grad(b) is exact there, O(h) next to the walls).              #
# ============================================================================= #
dimension 2
Pb_MHD pb
Domaine dom

Mailler dom
{
    Pave pave
    {
        Origine              0.  0.
        Nombre_de_Noeuds     11  11
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.
    }
}

Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 0.5
    dt_max 0.05
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    # Vector model: the Lorentz force requires the full vector b. #
    nb_composantes 2
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Convection_Diffusion_Magnetic_field
    {
        # eta = 0 and no transport velocity: b = (y,0) is an exact equilibrium. #
        diffusivite_magnetique Champ_Uniforme 1 0.

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche  Neumann_Paroi_adiabatique
            droite  Neumann_Paroi_adiabatique
            bas     Neumann_Paroi_adiabatique
            haut    Neumann_Paroi_adiabatique
        }
        # exactly linear vector field b = (y, 0) #
        initial_conditions { magnetic_field Champ_Fonc_xyz dom 2 y 0 }
    }

    # Optional momentum equation: presence => coupled low-Rm mode. #
    Navier_Stokes_standard
    {
        # Pressure solver: direct Cholesky through PETSc (the Sparskit-based #
        # direct Cholesky is deprecated and unstable here).                 #
        solveur_pression Petsc Cholesky { }
        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche  paroi_fixe
            droite  paroi_fixe
            bas     paroi_fixe
            haut    paroi_fixe
        }
        initial_conditions
        {
            vitesse Champ_Uniforme 2 0. 0.
        }
        sources
        {
            force_lorentz { }
        }
    }

    Postraitement
    {
        Sondes
        {
            # interior cell centres: u must stay 0 (curl-free force) #
            sonde_u grav vitesse Periode 1e-6 Points 2 0.45 0.45  0.45 0.75
            # pressure difference checks the Lorentz hydrostatic balance #
            sonde_p1 grav pression Periode 1e-6 Points 1 0.45 0.45
            sonde_p2 grav pression Periode 1e-6 Points 1 0.45 0.75
        }
    }

}

Solve pb
