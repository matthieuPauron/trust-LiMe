# PARALLEL OK #

# ============================================================================= #
# Coupled low-Rm MHD : Lorentz-force hydrostatic balance (3D)  (TRUST-LiMe) #
# ============================================================================= #
# 3D twin of MagneticCoupled/ForceLorentzBalance: b = (y, 0, 0) is an exact #
# equilibrium (eta = 0, no transport velocity), J = (0,0,-1), F = (0,-y,0) #
# is a pure gradient, so u = 0 and p = -y^2/2 + C.  Extruded in z with #
# insulating (Neumann) walls; the solution is z-independent. #
# ============================================================================= #

dimension 3
Pb_MHD pb
Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave pave
    {
        Origine              0.  0.  0.
        Nombre_de_Noeuds     $nx $ny $nz
        Longueurs            1.  1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.  0. <= Z <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.  0. <= Z <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.  0. <= Z <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.  0. <= Z <= 1.
        Bord devant   Z = 0.    0. <= X <= 1.  0. <= Y <= 1.
        Bord derriere Z = 1.    0. <= X <= 1.  0. <= Y <= 1.
    }
}

Polyedriser dom
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 0.5
    dt_max 0.05
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    nb_composantes 3
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Navier_Stokes_standard
    {
        solveur_pression Petsc Cholesky { }
        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche   paroi_fixe
            droite   paroi_fixe
            bas      paroi_fixe
            haut     paroi_fixe
            devant   paroi_fixe
            derriere paroi_fixe
        }
        initial_conditions
        {
            vitesse Champ_Uniforme 3 0. 0. 0.
        }
        sources
        {
            force_lorentz { }
        }
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 0.

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche   Neumann_Paroi_adiabatique
            droite   Neumann_Paroi_adiabatique
            bas      Neumann_Paroi_adiabatique
            haut     Neumann_Paroi_adiabatique
            devant   Neumann_Paroi_adiabatique
            derriere Neumann_Paroi_adiabatique
        }
        initial_conditions { magnetic_field Champ_Fonc_xyz dom 3 y 0 0 }
    }

    Postraitement
    {
        Sondes
        {
            sonde_u grav vitesse Periode 1e-6 Points 2 0.35 0.45 0.5  0.35 0.75 0.5
            sonde_p1 grav pression Periode 1e-6 Points 1 0.35 0.45 0.5
            sonde_p2 grav pression Periode 1e-6 Points 1 0.35 0.75 0.5
        }
    }

}

Solve pb
