# PARALLEL OK #

# ============================================================================= #
# Coupled MHD : TWO-WAY coupling feedback  (TRUST-LiMe)                         #
# ============================================================================= #
# Same physical case as Coupled_Feedback (b = (y, -x), eta = 0):                #
#     curl b = -2  =>  J = (0,0,-2)/mu0                                         #
#     F = J x b = -2(x,y,0)/mu0^2      (mu0 = 1, rho = 1)                       #
# F is a pure gradient, so the steady momentum balance in the closed box is    #
# the Lorentz hydrostatic rest:  u -> 0,  p = -(x^2 + y^2)/mu0^2 rho + C.       #
#                                                                               #
# ONE-WAY (Coupled_Feedback, the control): u is data (zero transport           #
# velocity) and b must stay frozen exactly.                                     #
#                                                                               #
# TWO-WAY (this form): the magnetic equation takes its transporting velocity    #
# from the SOLVED NS velocity (keyword 'vitesse_hydraulique').  During the     #
# viscous decay of u0 = (0.1, 0), the transient flow advects b:                #
#     (u . grad) b = (u_y, -u_x) != 0                                          #
# so the b probes MUST deviate from the frozen field (y, -x).  The             #
# deviation is the two-way discriminator; the one-way control pins the         #
# opposite behaviour.  No induction_stretching source here: the form isolates  #
# the convection feedback ((b.grad)u is exercised by the Hartmann two-way       #
# follow-up).                                                                  #
# ============================================================================= #
dimension 2
Pb_MHD pb
Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave pave
    {
        Origine              0.  0.
        Nombre_de_Noeuds     11  11
        Longueurs            1.  1.
    }
    {
        Bord gauche   X = 0.    0. <= Y <= 1.
        Bord droite   X = 1.    0. <= Y <= 1.
        Bord bas      Y = 0.    0. <= X <= 1.
        Bord haut     Y = 1.    0. <= X <= 1.
    }
}
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax 0.5
    dt_max 0.05
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    # Vector model: the two-way mode transports the full vector b. #
    nb_composantes 2
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    # Optional momentum equation: the solved velocity feeds back into the  #
    # magnetic convection, and b feeds the Lorentz force back into it.       #
    Navier_Stokes_standard
    {
        # Pressure solver: Petsc-wrapped direct solver (the Sparskit-based #
        # direct solver is deprecated and unstable here).                   #
        # WARNING: make_PAR.data may rewrite this solver — do not edit.     #
        solveur_pression Petsc Cholesky { }
        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche  paroi_fixe
            droite   paroi_fixe
            bas     paroi_fixe
            haut    paroi_fixe
        }
        initial_conditions
        {
            vitesse Champ_Uniforme 2 0.1 0.
        }
        sources
        {
            force_lorentz { }
        }
    }

    Convection_Diffusion_Magnetic_field
    {
        # eta = 0: the deviation of b is pure advection, no diffusion. #
        diffusivite_magnetique Champ_Uniforme 1 0.
        # TWO-WAY: the transporting velocity is the solved NS velocity. #
        vitesse_hydraulique

        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            gauche  Neumann_Paroi_adiabatique
            droite   Neumann_Paroi_adiabatique
            bas     Neumann_Paroi_adiabatique
            haut    Neumann_Paroi_adiabatique
        }
        # exactly linear vector field b = (y, -x) #
        initial_conditions { magnetic_field Champ_Fonc_xyz dom 2 y -x }
    }

    Postraitement
    {
        Sondes
        {
            # interior cell centres, off the partition joint (x=0.5): u must decay #
            sonde_u grav vitesse Periode 1e-6 Points 2 0.35 0.35  0.35 0.65
            # hydrostatic balance control (as in Coupled_Feedback / MMS_Coupled) #
            sonde_p1 grav pression Periode 1e-6 Points 1 0.35 0.35
            sonde_p2 grav pression Periode 1e-6 Points 1 0.65 0.65
            # two-way discriminator: b must deviate from the frozen (y, -x) #
            sonde_bx grav magnetic_field0 Periode 1e-6 Points 1 0.35 0.35
            sonde_by grav magnetic_field1 Periode 1e-6 Points 1 0.35 0.35
        }
    }

}

Solve pb
