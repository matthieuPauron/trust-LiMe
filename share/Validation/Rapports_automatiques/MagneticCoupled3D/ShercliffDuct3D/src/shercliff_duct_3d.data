# PARALLEL OK #
dimension 3
Pb_MHD pb
Domaine dom

# BEGIN MESH #
Mailler dom
{
    Pave cube
    {
        Origine              0. -0.5 -0.5
        Nombre_de_Noeuds     $nx $ny $nz
        Longueurs            1.  1.  1.
    }
    {
        Bord gauche   X = 0.   -0.5 <= Y <= 0.5  -0.5 <= Z <= 0.5
        Bord droite   X = 1.   -0.5 <= Y <= 0.5  -0.5 <= Z <= 0.5
        Bord bas      Y = -0.5  0. <= X <= 1.  -0.5 <= Z <= 0.5
        Bord haut     Y = 0.5   0. <= X <= 1.  -0.5 <= Z <= 0.5
        Bord devant   Z = -0.5  0. <= X <= 1.  -0.5 <= Y <= 0.5
        Bord derriere Z = 0.5   0. <= X <= 1.  -0.5 <= Y <= 0.5
    }
}

Polyedriser dom
# END MESH #

# BEGIN PARTITION
Partition dom
{
    Partition_tool metis { nb_parts 2 }
    Larg_joint 2
    zones_name DOM
}
End
END PARTITION #

# BEGIN SCATTER
Scatter DOM.Zones dom
END SCATTER #


Polymac_p0 dis

Associate pb dom

Schema_Euler_Implicite sch
Read sch
{
    tinit 0.
    tmax $tmax
    dt_max 0.05
    facsec 1e6
    facsec_max 1e6
    solveur implicite { solveur petsc cli { } }
}

Associate pb sch
Discretize pb dis

Read pb
{
    # vector model: b = (b_x induced, 0, B0 applied) #
    nb_composantes 3
    fluide_incompressible
    {
        mu      Champ_Uniforme 1 1.0
        rho     Champ_Uniforme 1 1.0
        lambda  Champ_Uniforme 1 1.0
        Cp      Champ_Uniforme 1 1.0
        beta_th Champ_Uniforme 1 0.0
    }

    Navier_Stokes_standard
    {
        solveur_pression Petsc Cholesky { }
        diffusion  { }
        convection { amont }

        boundary_conditions
        {
            # open boundaries driving the flow; the magnetic-pressure profile   #
            # p = P - b_x(y,z)^2/(2 mu0) is injected through $pmag (a closed    #
            # form of the Shercliff b_x, or 0 for the Ha=0 control)             #
            gauche   frontiere_ouverte_pression_imposee Champ_front_fonc_txyz 1 1.-$pmag
            droite   frontiere_ouverte_pression_imposee Champ_front_fonc_txyz 1 -$pmag
            bas      paroi_fixe
            haut     paroi_fixe
            devant   paroi_fixe
            derriere paroi_fixe
        }
        initial_conditions
        {
            vitesse Champ_Uniforme 3 0. 0. 0.
        }
        sources
        {
            force_lorentz { }
        }
    }

    Convection_Diffusion_Magnetic_field
    {
        diffusivite_magnetique Champ_Uniforme 1 $eta
        vitesse_hydraulique

        diffusion  { }
        convection { amont }

        # M1 inductive stretching source S = (b.grad) u : S_x = B0 du/dz #
        sources
        {
            induction_stretching { }
        }

        boundary_conditions
        {
            # insulating walls: zero normal flux on every component #
            gauche   Neumann_Paroi_adiabatique
            droite   Neumann_Paroi_adiabatique
            bas      Neumann_Paroi_adiabatique
            haut     Neumann_Paroi_adiabatique
            devant   Neumann_Paroi_adiabatique
            derriere Neumann_Paroi_adiabatique
        }
        # b = (0, 0, B0) initially : the induced field grows from zero #
        initial_conditions { magnetic_field Champ_Uniforme 3 0. 0. 1. }
    }

    Postraitement
    {
        Sondes
        {
            # cross-section probes at x = 0.375 (off the open boundaries):       #
            # y along the side-wall direction, z along the Hartmann direction    #
            sonde_a1 grav vitesse Periode 1e-8 Points 1 0.375  0.0    0.0
            sonde_a2 grav vitesse Periode 1e-8 Points 1 0.375  0.0    0.25
            sonde_a3 grav vitesse Periode 1e-8 Points 1 0.375  0.0    0.45
            sonde_a4 grav vitesse Periode 1e-8 Points 1 0.375  0.25   0.0
            sonde_a5 grav vitesse Periode 1e-8 Points 1 0.375  0.45   0.0
            sonde_a6 grav vitesse Periode 1e-8 Points 1 0.375  0.25   0.25
            sonde_bx grav magnetic_field0 Periode 1e-8 Points 1 0.375  0.0    0.0
            sonde_bz grav magnetic_field2 Periode 1e-8 Points 1 0.375  0.0    0.0
        }
    }

}

Solve pb