# Generated by trust at baltik creation - do not edit by hand, unless you know what you are doing.
SHELL             = /bin/bash

PROJECT_NAME      = trust_LiMe

# TRUST_ROOT must come from the live environment. This Makefile is
# generated once at baltik creation; baking in a path here would freeze
# the TRUST checkout the baltik was created against, which breaks the
# build as soon as that checkout is moved, renamed, or deleted.
ifeq ($(strip $(TRUST_ROOT)),)
$(error TRUST_ROOT is not set. Set it manually before running make, or source env_$(PROJECT_NAME).sh or env_TRUST.sh)
endif

# project_directory is derived from CURDIR. This Makefile is expected
# to be invoked from inside <baltik>/docs/ (either by `cd docs && make`
# or via `make -C docs`); the baltik identity is then locally unambiguous.
# Using := (not ?=) prevents a stale `project_directory` inherited from
# an unrelated `env_<other>.sh` (e.g. the user sourced another baltik's
# env, then cd-ed here) from silently redirecting the build to the wrong
# baltik — which results in the wrong main_page being scanned, sources
# from the wrong tree, and an empty keyword reference.
project_directory := $(realpath $(CURDIR)/..)
# Exported so child processes (the trustify CLI, the Doxyfile expander)
# see them without having to source env_$(PROJECT_NAME).sh — that
# script uses `source`, which is a bash builtin that fails when make
# runs recipes under /bin/sh.
export TRUST_ROOT
export project_directory
export PROJECT_NAME

# Both the keyword reference (trustify_doc) and the C++ API INPUT
# (doxyfile_chain in baltik.mk) auto-resolve this baltik's transitive
# dependencies via trustify - no manual enumeration required.  Override
# the resolution by setting BALTIK_DEPENDENCIES, e.g.
#   make BALTIK_DEPENDENCIES="/abs/dep_a /abs/dep_b"

# Fallback for TRUST_VERSION (normally set by env_TRUST.sh). We compute
# it here so the Doxyfile template expansion works even when the user
# runs `make` without sourcing env_$(PROJECT_NAME).sh first. `ifndef`
# rather than `?=` so the shell only runs once.
ifndef TRUST_VERSION
TRUST_VERSION := $(shell cat $(TRUST_ROOT)/VERSION)
endif
export TRUST_VERSION

# -----------------------------------------------------------------------
# Layout
#
# common.mk derives HTML_DIR, KW_DST_DIR, GENERATED_CONTENT_DIR from
# BUILD_DIR - we only declare what's specific to this baltik.
# -----------------------------------------------------------------------
# TRUST_DOC_DIR is the bootstrap path the baltik MUST know to load the
# shared make rules (common.mk / baltik.mk).  It is the only TRUST-tree
# path baked into a baltik's docs/Makefile; everything else lives behind
# defaults inside those shared rules and can be relocated upstream
# without touching existing baltiks.
TRUST_DOC_DIR = $(TRUST_ROOT)/docs
BUILD_DIR     = $(CURDIR)/build
export BUILD_DIR

# Fail with a clear message if the TRUST docs tree has been moved or is
# missing — otherwise `include` below would emit a confusing
# "No such file or directory" error.  Set TRUST_DOC_DIR explicitly to
# override.
ifeq ($(wildcard $(TRUST_DOC_DIR)/common.mk),)
$(error TRUST_DOC_DIR=$(TRUST_DOC_DIR) does not contain common.mk - has the TRUST docs tree been moved? Set TRUST_DOC_DIR explicitly to the new location.)
endif

# -----------------------------------------------------------------------
# Help preamble - consumed by the `help` target in common.mk
# -----------------------------------------------------------------------
define HELP_PREAMBLE
Usage: make [target]   (run from $(PROJECT_NAME)/docs/)

Combo targets:
  all          Regenerate keyword reference + Doxyfile.chain, then build HTML (default)
  run_doxygen  Build HTML (always refreshes Doxyfile.chain; does NOT
               re-run trustify - use `all` for that)

For more info: $(TRUST_ROOT)/bin/baltik/README_INSTALL.md  (baltik doc pipeline)
               $(TRUST_ROOT)/docs/README.md                (shared pipeline + TRUST docs)
endef

# `all` is the default goal. We set it explicitly because the
# includes below introduce targets, and Make would otherwise pick the
# first one in the include as the default.
.DEFAULT_GOAL := all

# Shared rules.
# common.mk : DOXYGEN resolution, install_doxygen, install_trustify,
#             clean_doxygen, the doxygen recipe + post-processing.
# baltik.mk : Doxyfile (generated from the TRUST template if missing)
#             and doxyfile_chain (resolves BALTIK_DEPENDENCIES at recipe
#             time, after install_trustify has run).
include $(TRUST_DOC_DIR)/common.mk
include $(TRUST_DOC_DIR)/baltik.mk

.PHONY: all clean run_doxygen

# Two-phase build via $(MAKE).  Make's prerequisite list inside a single
# rule (`all: a b`) does NOT guarantee that `a` finishes before `b`
# starts when run under `make -j`; the two are scheduled in parallel.
# Splitting into sub-make invocations creates an explicit phase barrier:
# every target invoked by phase N completes before phase N+1 starts.
#
# Phase 1 must include every step that PRODUCES content doxygen will
# READ (markdown under $(GENERATED_CONTENT_DIR), Doxyfile.chain, ...).
# Phase 2 is the doxygen run itself.
#
# To add a baltik-specific content generator (e.g. a target that writes
# extra .md files into $(GENERATED_CONTENT_DIR) for doxygen to pick up):
#
#   1. Define the target.  Write outputs under $(GENERATED_CONTENT_DIR)
#      so they're inside docs/build/ and are wiped by `make clean`:
#
#        my_extra_content:
#            @mkdir -p $(GENERATED_CONTENT_DIR)
#            @./my_generator.py > $(GENERATED_CONTENT_DIR)/extra.md
#
#   2. Add it to phase 1 below.  Group it with trustify_doc on the same
#      $(MAKE) line so both content generators run in parallel within
#      the phase:
#
#        @$(MAKE) --no-print-directory trustify_doc my_extra_content
#
# DO NOT add the new target directly to `all:` as a prereq - that loses
# the phase guarantee.  DO NOT add it as a prereq of `run_doxygen:` either,
# unless you genuinely want it re-run on every standalone `make run_doxygen`.
all:
	@$(MAKE) --no-print-directory trustify_doc
	@$(MAKE) --no-print-directory run_doxygen

# Extend the shared `run_doxygen` target's prereqs (common.mk supplies
# the recipe). The baltik needs the Doxyfile to exist and Doxyfile.chain
# to be up to date before running doxygen.
run_doxygen: Doxyfile doxyfile_chain

# Everything generated by the pipeline lives under $(BUILD_DIR), so
# `clean` is just an alias for the shared `clean_build`.  Finer-grained
# `clean_html` and `clean_kw_ref` come from common.mk for fast iteration.
# Add your own targets as prereqs to extend the cleanup, e.g.:
#   clean: clean_my_extras
#   clean_my_extras:
#       @rm -rf my_extras/
clean: clean_build                            ## Remove all generated artefacts (alias for clean_build)
