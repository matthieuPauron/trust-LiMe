#---------------------------------------------------------------------------
# Baltik documentation Doxyfile — generated by `make` in this directory
# from $TRUST_ROOT/bin/baltik/templates/basic/docs/Doxyfile.
#
# This file carries ONLY:
#   * the project's identity (PROJECT_NAME, PROJECT_BRIEF, ...)
#   * project-specific paths (OUTPUT_DIRECTORY, INPUT, HTML_HEADER, ...)
#   * an `@INCLUDE` of TRUST's shared doxyfile_common (theme, MathJax,
#     output options, extraction, graphs, search, ...)
#   * an optional user-override block (initially empty, edit freely)
#   * the auto-generated Doxyfile.chain for ancestor-baltik INPUT
#
# Notation in this file:
#   Two-at notation (e.g. PROJECT_NAME below) — one-shot substitution
#       by expand_env.py at `make` time.  Used only for things that do
#       not change after creation.
#   Dollar-paren notation (e.g. for TRUST_ROOT, TRUST_VERSION,
#       project_directory) — looked up by Doxygen itself at every
#       invocation, so the same Doxyfile tracks env changes.  This lets
#       the user rebuild docs against a different TRUST (or move the
#       baltik) without having to delete and regenerate this file.
#
# Why this split ?  Theme updates, MathJax bumps, new search
# behaviour, and other documentation-system improvements live in
# $TRUST_ROOT/docs/doxyfile_common.  Because we @INCLUDE that file every
# build (not just at baltik creation), those improvements take effect on
# next `make` with no need to delete or regenerate this Doxyfile — your
# customisations in the override block below are preserved.
#---------------------------------------------------------------------------

PROJECT_NAME           = trust_LiMe
PROJECT_NUMBER         = $(TRUST_VERSION)
PROJECT_BRIEF          = "trust_LiMe documentation"

#---------------------------------------------------------------------------
# Input: this baltik's narrative content + sources + TRUST sources.
# docs/content/ holds hand-written Markdown pages — main_page.md (the
# @mainpage) and demo.md ship as a starting point; the directory is
# scanned recursively (RECURSIVE = YES in doxyfile_common), so new pages
# dropped there are picked up with no Doxyfile edit (no need to list
# main_page.md separately).  This mirrors TRUST's own docs/content/
# layout.  Ancestor baltik `build/src` dirs (when this is a sub-baltik)
# are appended via `INPUT += ...` from the auto-generated Doxyfile.chain
# at the bottom of this file, so the chain reflects the current
# `[dependencies]` without us having to edit anything by hand.
#---------------------------------------------------------------------------
INPUT                  = $(project_directory)/docs/content \
                         $(TRUST_ROOT)/src \
                         $(project_directory)/src

#---------------------------------------------------------------------------
# HTML header — per-baltik file under docs/theme/ (mirrors TRUST's
# docs/theme/header.html) so each project can customise the GitHub
# corner / logo / etc.  See "Customising the HTML header" in
# $TRUST_ROOT/bin/baltik/README_INSTALL.md.
#---------------------------------------------------------------------------
HTML_HEADER            = $(project_directory)/docs/theme/header.html

#---------------------------------------------------------------------------
# Shared defaults from TRUST.  Re-read on every `make`, so any change
# upstream (theme, MathJax, output options, ...) takes effect here
# automatically — no Doxyfile regeneration needed.
#---------------------------------------------------------------------------
@INCLUDE               = $(TRUST_ROOT)/docs/doxyfile_common

#---------------------------------------------------------------------------
# Favicon (browser-tab icon).  doxyfile_common ships no favicon — each
# project declares its own.  This defaults to TRUST's icon; to use your
# own, drop a favicon.ico into docs/theme/ and point this at
# $(project_directory)/docs/theme/favicon.ico instead.  theme/header.html
# references it by the bare name "favicon.ico", so the file must be named
# that.  (Must come AFTER the @INCLUDE above, which sets HTML_EXTRA_FILES.)
#---------------------------------------------------------------------------
HTML_EXTRA_FILES       += $(TRUST_ROOT)/docs/theme/favicon.ico

#---------------------------------------------------------------------------
# === USER OVERRIDES BELOW ===
#
# Override any setting from doxyfile_common here.  Doxygen's @INCLUDE
# semantics: a later assignment wins, so anything below this comment
# block takes precedence over the shared defaults.  Examples:
#
#   CALL_GRAPH         = YES
#   GENERATE_LATEX     = YES
#   IMAGE_PATH        += $(project_directory)/docs/images
#   EXCLUDE_PATTERNS  += $(project_directory)/src/legacy/*
#
# To show an image referenced straight from docs/theme/header.html (e.g. a
# sidebar logo via `<img src="$relpath^my_logo.png">`), list the FILE here
# so Doxygen copies it to the output root — header images are NOT scanned,
# so IMAGE_PATH does not cover them.  HTML_EXTRA_FILES takes files only, not
# directories (a directory errors out and copies nothing):
#   HTML_EXTRA_FILES  += $(project_directory)/docs/theme/my_logo.png
#---------------------------------------------------------------------------

#---------------------------------------------------------------------------
# Ancestor-baltik INPUT extension (auto-generated, do not edit by hand).
# Doxyfile.chain is rewritten by the `doxyfile_chain` target on every
# build with `INPUT += <ancestor>/src` for each baltik in the
# current project.cfg [dependencies] chain.  Contains only header
# comments when the project has no ancestor baltiks.
#---------------------------------------------------------------------------
@INCLUDE_PATH          = $(project_directory)/docs/build
@INCLUDE               = Doxyfile.chain
